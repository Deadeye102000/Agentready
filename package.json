{
  "name": "agentready",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @agentready/web --filter @agentready/api dev",
    "dev:web": "pnpm --filter @agentready/web dev",
    "dev:api": "pnpm --filter @agentready/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:all": "pnpm -r test",
    "test:api": "pnpm --filter @agentready/api test",
    "test:web": "pnpm --filter @agentready/web test",
    "test:mcp": "pnpm --filter @agentready/mcp-server test",
    "test:integration": "pnpm --filter @agentready/api test:integration",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:reset": "prisma db push --schema prisma/schema.prisma --force-reset",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:health": "tsx --env-file=.env packages/db/scripts/check-db.ts",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.3",
      "fast-uri": ">=3.1.6",
      "@opentelemetry/core": ">=2.8.0",
      "next": "^15.5.25",
      "postcss": ">=8.5.28",
      "nanoid": ">=3.3.18",
      "deepmerge-ts": ">=8.0.2",
      "find-my-way": ">=9.7.0",
      "sharp": ">=0.35.0"
    }
  }
}
