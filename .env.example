# Database connection:
# For Supabase: DATABASE_URL is the pooled connection (port 6543, ?pgbouncer=true) and DIRECT_URL is port 5432
DATABASE_URL="postgresql://agentready:agentready@localhost:5432/agentready?schema=public"
DIRECT_URL="postgresql://agentready:agentready@localhost:5432/agentready?schema=public"
POSTGRES_DB="agentready"
POSTGRES_USER="agentready"
POSTGRES_PASSWORD="agentready"
API_PORT=3001
API_HOST="0.0.0.0"
API_BODY_LIMIT_BYTES=1048576
API_CORS_ORIGINS="http://localhost:3000"
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW="1 minute"
API_AUTH_RATE_LIMIT_MAX=20
API_AUTH_RATE_LIMIT_WINDOW="1 minute"
AUTH_SESSION_SECRET="change-me-to-at-least-32-random-characters"
WEB_PORT=3000
MCP_SERVER_PORT=3002
NODE_ENV="development"

# Frontend -> API Backend URL (browser-accessible public endpoint)
# Used by Next.js client components to communicate with the AgentReady Fastify API.
NEXT_PUBLIC_AGENTREADY_API_URL="http://localhost:3001"

# Server-Side API URL
# Used by Next.js server components, API route handlers (/api/sandbox), and the MCP server
# to communicate directly with the AgentReady Fastify API backend.
AGENTREADY_API_URL="http://localhost:3001"

# MCP Server Auth Token / API Key
# Fallback Bearer auth token used by @agentready/mcp-server to authenticate with the API.
AGENTREADY_AUTH_TOKEN="ar_dev_demo_agent_key_change_me"

# Web Sandbox Agent API Key
# Machine Bearer key used by the Next.js interactive sandbox proxy (/api/sandbox)
# to execute agent runs against the backend. Defaults to the seeded demo agent key in dev.
# In production, this must be set to a secure, unique agent API key.
SANDBOX_AGENT_API_KEY="ar_dev_demo_agent_key_change_me"
